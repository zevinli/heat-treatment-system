import React from 'react';
import { createRoot } from "react-dom/client";
import './index.css';

// Minimal test - render just a heading
function MinimalApp() {
  return React.createElement('div', { style: { padding: 40, fontFamily: 'system-ui' } },
    React.createElement('h1', null, '✅ React 渲染成功!'),
    React.createElement('p', null, '如果看到这行字，说明基础渲染正常。')
  );
}

createRoot(document.getElementById("root")!).render(React.createElement(MinimalApp));
